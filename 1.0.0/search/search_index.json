{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#_1","title":"\u751f\u5316\u5b66\u5b66\u7fd2\u30b2\u30fc\u30e0 \u8aac\u660e\u66f8","text":""},{"location":"#1","title":"1. \u30b2\u30fc\u30e0\u6982\u8981","text":"<p>\u672c\u30b2\u30fc\u30e0\u306f\u3001\u751f\u5316\u5b66\u306b\u95a2\u3059\u308b\u77e5\u8b58\u306e\u7fd2\u5f97\u3068\u7406\u89e3\u3092\u76ee\u7684\u3068\u3057\u305f\u4e00\u554f\u4e00\u7b54\u5f62\u5f0f\u306e\u5b66\u7fd2\u30b2\u30fc\u30e0\u3067\u3042\u308b\u3002</p> <p>\u5927\u5b66\u306e\u751f\u5316\u5b66\u3067\u6271\u3046\u4ee3\u8b1d\u7d4c\u8def\u3001\u9175\u7d20\u53cd\u5fdc\u3001\u88dc\u9175\u7d20\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u4ee3\u8b1d\u3001\u30bf\u30f3\u30d1\u30af\u8cea\u306e\u69cb\u9020\u3068\u6a5f\u80fd\u306a\u3069\u3092\u984c\u6750\u3068\u3057\u3001\u554f\u984c\u3078\u306e\u56de\u7b54\u3092\u901a\u3057\u3066\u751f\u4f53\u5185\u3067\u8d77\u3053\u308b\u5316\u5b66\u53cd\u5fdc\u3084\u751f\u547d\u73fe\u8c61\u306e\u4ed5\u7d44\u307f\u3092\u5b66\u7fd2\u3067\u304d\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3057\u3066\u3044\u308b\u3002</p> <p>\u5358\u7d14\u306a\u7528\u8a9e\u306e\u6697\u8a18\u3060\u3051\u3067\u306a\u304f\u3001\u53cd\u5fdc\u304c\u8d77\u3053\u308b\u7406\u7531\u3084\u5404\u7269\u8cea\u306e\u5f79\u5272\u306a\u3069\u3001\u8907\u6570\u306e\u77e5\u8b58\u3092\u95a2\u9023\u4ed8\u3051\u3066\u8003\u3048\u308b\u3053\u3068\u3092\u91cd\u8996\u3057\u3066\u3044\u308b\u3002</p>"},{"location":"#2","title":"2. \u30b2\u30fc\u30e0\u306e\u57fa\u672c\u30eb\u30fc\u30eb","text":"<ul> <li>\u753b\u9762\u306b\u8868\u793a\u3055\u308c\u308b\u751f\u5316\u5b66\u306e\u554f\u984c\u306b\u56de\u7b54\u3059\u308b\u3002</li> <li>\u554f\u984c\u5f62\u5f0f\u306f\u4e3b\u306b\u9078\u629e\u5f0f\u306e\u4e00\u554f\u4e00\u7b54\u3068\u3059\u308b\u3002</li> <li>\u56de\u7b54\u5f8c\u3001\u6b63\u89e3\u30fb\u4e0d\u6b63\u89e3\u304c\u5224\u5b9a\u3055\u308c\u308b\u3002</li> <li>\u5224\u5b9a\u5f8c\u306b\u306f\u89e3\u8aac\u304c\u8868\u793a\u3055\u308c\u3001\u6b63\u89e3\u306e\u6839\u62e0\u3084\u95a2\u9023\u3059\u308b\u751f\u5316\u5b66\u7684\u306a\u4ed5\u7d44\u307f\u3092\u78ba\u8a8d\u3067\u304d\u308b\u3002</li> <li>\u554f\u984c\u3092\u7e70\u308a\u8fd4\u3057\u89e3\u304f\u3053\u3068\u3067\u3001\u77e5\u8b58\u306e\u5b9a\u7740\u3092\u76ee\u6307\u3059\u3002</li> </ul>"},{"location":"#3","title":"3. \u554f\u984c\u306e\u5185\u5bb9","text":"<p>\u554f\u984c\u306f\u5927\u5b66\u306e\u751f\u5316\u5b66\u3067\u6271\u3046\u5185\u5bb9\u3092\u4e2d\u5fc3\u306b\u69cb\u6210\u3059\u308b\u3002</p> <p>\u4e3b\u306a\u51fa\u984c\u5206\u91ce\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3042\u308b\u3002</p> <ul> <li>\u7cd6\u8cea\u4ee3\u8b1d\uff08\u89e3\u7cd6\u7cfb\u3001\u7cd6\u65b0\u751f\u3001TCA\u56de\u8def\u306a\u3069\uff09</li> <li>\u8102\u8cea\u4ee3\u8b1d\uff08\u8102\u80aa\u9178\u306e\u03b2\u9178\u5316\u3001\u8102\u80aa\u9178\u5408\u6210\u306a\u3069\uff09</li> <li>\u30a2\u30df\u30ce\u9178\u4ee3\u8b1d</li> <li>\u9175\u7d20\u306e\u50cd\u304d\u3068\u53cd\u5fdc\u6a5f\u69cb</li> <li>\u88dc\u9175\u7d20\uff08NADH\u3001NADPH\u3001FAD\u306a\u3069\uff09</li> <li>\u96fb\u5b50\u4f1d\u9054\u7cfb\u3068\u9178\u5316\u7684\u30ea\u30f3\u9178\u5316</li> <li>\u30bf\u30f3\u30d1\u30af\u8cea\u306e\u69cb\u9020\u3068\u6a5f\u80fd</li> <li>DNA\u30fbRNA\u3068\u30bf\u30f3\u30d1\u30af\u8cea\u5408\u6210</li> <li>\u751f\u4f53\u5185\u306e\u60c5\u5831\u4f1d\u9054\u3068\u8abf\u7bc0\u6a5f\u69cb</li> </ul> <p>\u5358\u7d14\u306a\u77e5\u8b58\u554f\u984c\u306b\u52a0\u3048\u3001\u53cd\u5fdc\u7d4c\u8def\u306e\u7406\u89e3\u3084\u7269\u8cea\u540c\u58eb\u306e\u95a2\u4fc2\u3092\u8003\u3048\u308b\u554f\u984c\u3082\u53d6\u308a\u5165\u308c\u308b\u3002</p>"},{"location":"#4","title":"4. \u4e3b\u306a\u6a5f\u80fd","text":""},{"location":"#41","title":"4.1 \u6b63\u8aa4\u5224\u5b9a","text":"<p>\u9078\u629e\u3057\u305f\u56de\u7b54\u304c\u6b63\u3057\u3044\u304b\u3069\u3046\u304b\u3092\u81ea\u52d5\u7684\u306b\u5224\u5b9a\u3059\u308b\u3002</p>"},{"location":"#42","title":"4.2 \u89e3\u8aac\u8868\u793a","text":"<p>\u56de\u7b54\u5f8c\u306b\u554f\u984c\u306e\u89e3\u8aac\u3092\u8868\u793a\u3059\u308b\u3002\u6b63\u89e3\u3060\u3051\u3067\u306a\u304f\u3001\u53cd\u5fdc\u306e\u4ed5\u7d44\u307f\u3084\u95a2\u9023\u3059\u308b\u77e5\u8b58\u306b\u3064\u3044\u3066\u3082\u8aac\u660e\u3057\u3001\u7406\u89e3\u3092\u6df1\u3081\u3089\u308c\u308b\u3088\u3046\u306b\u3059\u308b\u3002</p>"},{"location":"#43","title":"4.3 \u30b9\u30b3\u30a2\u6a5f\u80fd","text":"<p>\u554f\u984c\u3078\u306e\u6b63\u89e3\u306b\u5fdc\u3058\u3066\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u308b\u3002\u5b66\u7fd2\u306e\u6210\u679c\u3092\u6570\u5024\u3068\u3057\u3066\u78ba\u8a8d\u3067\u304d\u308b\u3002</p>"},{"location":"#44","title":"4.4 \u9023\u7d9a\u6b63\u89e3\u30dc\u30fc\u30ca\u30b9","text":"<p>\u9023\u7d9a\u3057\u3066\u6b63\u89e3\u3059\u308b\u3068\u8ffd\u52a0\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u308b\u3002\u6b63\u78ba\u306a\u56de\u7b54\u3092\u7d99\u7d9a\u3059\u308b\u3053\u3068\u3092\u4fc3\u3059\u6a5f\u80fd\u3067\u3042\u308b\u3002</p>"},{"location":"#45","title":"4.5 \u5b9f\u7e3e\u6a5f\u80fd","text":"<p>\u6b63\u89e3\u6570\u3084\u9023\u7d9a\u6b63\u89e3\u6570\u306a\u3069\u3001\u30d7\u30ec\u30a4\u4e2d\u306e\u6210\u7e3e\u306b\u5fdc\u3058\u3066\u5b9f\u7e3e\u3092\u7372\u5f97\u3067\u304d\u308b\u3002</p>"},{"location":"#46","title":"4.6 \u5b66\u7fd2\u8a18\u9332","text":"<p>\u6b63\u7b54\u7387\u3084\u56de\u7b54\u7d50\u679c\u3092\u8a18\u9332\u3057\u3001\u81ea\u5206\u306e\u7406\u89e3\u5ea6\u3092\u632f\u308a\u8fd4\u308b\u305f\u3081\u306b\u5229\u7528\u3059\u308b\u3002</p> <p>\u203b\u5404\u6a5f\u80fd\u306e\u5b9f\u88c5\u72b6\u6cc1\u306b\u5fdc\u3058\u3066\u3001\u5b9f\u969b\u306b\u642d\u8f09\u3057\u3066\u3044\u308b\u3082\u306e\u3092\u8a18\u8f09\u3059\u308b\u3002</p>"},{"location":"#5","title":"5. \u30b2\u30fc\u30e0\u306e\u7279\u5fb4","text":"<p>\u672c\u30b2\u30fc\u30e0\u306e\u7279\u5fb4\u306f\u3001\u751f\u5316\u5b66\u3092\u5358\u306a\u308b\u6697\u8a18\u79d1\u76ee\u3068\u3057\u3066\u6271\u308f\u305a\u3001\u751f\u547d\u73fe\u8c61\u3092\u5316\u5b66\u7684\u306a\u8996\u70b9\u304b\u3089\u7406\u89e3\u3059\u308b\u3053\u3068\u3092\u76ee\u6307\u3057\u3066\u3044\u308b\u70b9\u306b\u3042\u308b\u3002</p> <p>\u4f8b\u3048\u3070\u3001NADH\u3068NADPH\u306e\u5f79\u5272\u306e\u9055\u3044\u3092\u554f\u3046\u5834\u5408\u3001\u5358\u306b\u540d\u79f0\u3084\u7528\u9014\u3092\u899a\u3048\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u7570\u5316\u3068\u540c\u5316\u306b\u304a\u3051\u308b\u96fb\u5b50\u306e\u53d7\u3051\u6e21\u3057\u306e\u9055\u3044\u307e\u3067\u7406\u89e3\u3067\u304d\u308b\u3088\u3046\u306a\u89e3\u8aac\u3092\u7528\u610f\u3059\u308b\u3002</p> <p>\u307e\u305f\u3001\u9023\u7d9a\u6b63\u89e3\u30dc\u30fc\u30ca\u30b9\u3084\u5b9f\u7e3e\u6a5f\u80fd\u3092\u8a2d\u3051\u308b\u3053\u3068\u3067\u3001\u7e70\u308a\u8fd4\u3057\u554f\u984c\u306b\u53d6\u308a\u7d44\u3080\u610f\u6b32\u3092\u9ad8\u3081\u308b\u3002</p> <ol> <li>\u958b\u767a\u76ee\u7684</li> </ol> <p>\u751f\u5316\u5b66\u306f\u3001\u5316\u5b66\u53cd\u5fdc\u3084\u5206\u5b50\u306e\u76f8\u4e92\u4f5c\u7528\u3092\u901a\u3057\u3066\u751f\u547d\u73fe\u8c61\u3092\u7406\u89e3\u3059\u308b\u5b66\u554f\u3067\u3042\u308b\u3002\u3057\u304b\u3057\u3001\u4ee3\u8b1d\u7d4c\u8def\u3084\u9175\u7d20\u53cd\u5fdc\u306a\u3069\u306f\u899a\u3048\u308b\u5185\u5bb9\u304c\u591a\u304f\u3001\u500b\u3005\u306e\u77e5\u8b58\u304c\u72ec\u7acb\u3057\u3066\u3057\u307e\u3044\u3084\u3059\u3044\u3002</p> <p>\u305d\u3053\u3067\u3001\u672c\u30b2\u30fc\u30e0\u3067\u306f\u554f\u984c\u3078\u306e\u56de\u7b54\u3068\u89e3\u8aac\u3092\u7e70\u308a\u8fd4\u3059\u3053\u3068\u3067\u3001\u500b\u3005\u306e\u77e5\u8b58\u3092\u95a2\u9023\u4ed8\u3051\u306a\u304c\u3089\u5b66\u7fd2\u3067\u304d\u308b\u74b0\u5883\u3092\u76ee\u6307\u3057\u305f\u3002</p> <p>\u30b2\u30fc\u30e0\u3068\u3057\u3066\u306e\u697d\u3057\u3055\u3068\u5927\u5b66\u30ec\u30d9\u30eb\u306e\u5b66\u7fd2\u5185\u5bb9\u3092\u4e21\u7acb\u3055\u305b\u3001\u751f\u5316\u5b66\u3078\u306e\u8208\u5473\u3084\u7406\u89e3\u3092\u6df1\u3081\u308b\u3053\u3068\u3092\u958b\u767a\u306e\u76ee\u7684\u3068\u3057\u3066\u3044\u308b\u3002</p> <ol> <li>\u4f7f\u7528\u65b9\u6cd5</li> </ol> <p>\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u8d77\u52d5\u3059\u308b\u3002</p> <p>\u30b2\u30fc\u30e0\u753b\u9762\u304b\u3089\u554f\u984c\u3092\u958b\u59cb\u3059\u308b\u3002</p> <p>\u8868\u793a\u3055\u308c\u305f\u554f\u984c\u3092\u8aad\u307f\u3001\u56de\u7b54\u3092\u9078\u629e\u3059\u308b\u3002</p> <p>\u6b63\u8aa4\u5224\u5b9a\u3068\u89e3\u8aac\u3092\u78ba\u8a8d\u3059\u308b\u3002</p> <p>\u6b21\u306e\u554f\u984c\u3078\u9032\u307f\u3001\u7e70\u308a\u8fd4\u3057\u5b66\u7fd2\u3059\u308b\u3002</p> <p>\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u30b9\u30b3\u30a2\u3084\u5b9f\u7e3e\u3092\u78ba\u8a8d\u3059\u308b\u3002</p>"}]}